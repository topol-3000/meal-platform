{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familymeal.local/contracts/events/envelope.schema.json",
  "title": "Event envelope (Redis Streams entry fields)",
  "description": "Every stream entry carries these fields. All values are strings because Redis stream fields are strings; `payload` is JSON validated by the per-event schema.",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "payload", "traceparent"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid", "description": "Unique id, used for idempotent handling" },
    "event_type": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$", "description": "Equals the stream name, e.g. recipe.import.requested" },
    "event_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "pattern": "^meal-[a-z0-9-]+$" },
    "payload": { "type": "string", "contentMediaType": "application/json" },
    "traceparent": { "type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$", "description": "W3C Trace Context" },
    "tracestate": { "type": "string" }
  },
  "additionalProperties": false
}
